# ==========================================
# UNSEEN — Environment Configuration
# ==========================================

# (Optional) Supabase Credentials for Cloud Sync & Authentication
# If omitted or left empty, UNSEEN runs in Local Persistent Mode
# with instant offline storage and guest demo sessions.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# (Optional) App Environment
VITE_APP_ENV=production
